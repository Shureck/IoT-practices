# Скопируйте в .env и при необходимости измените: cp .env.example .env

# Порт веб-приложения на хосте
APP_PORT=8080

# Секрет для подписи сессий (JWT). Если пусто — генерируется и сохраняется в томе /data/secret.
JWT_SECRET=

# Код, который вводит преподаватель при регистрации
TEACHER_INVITE=teacher2025

# 1 — создать демо-аккаунты teacher@demo.local / teacher123, student@demo.local / student123
#     и группу «Демо-группа» (код DEMO25). Для «боевого» сервера поставьте 0.
SEED_DEMO=1

# MQTT для настоящих плат: адрес и порт, которые сайт подсказывает студентам.
# Обычно это IP сервера в локальной сети (например, 192.168.1.10). Пусто — имя хоста из адреса сайта.
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_PORT=1883
# Порт брокера на хосте
MQTT_PORT=1883

# Сайт открыт по HTTPS (через обратный прокси) — cookie только по HTTPS
COOKIE_SECURE=0
# Сервер стоит за обратным прокси (nginx, Caddy, Traefik) — доверять X-Forwarded-For
TRUST_PROXY=0

# Параллельных автопроверок (пусто — min(4, ядер−1))
CHECK_WORKERS=

# Сервис компиляции: параллельных сборок, ядер, памяти
COMPILER_SLOTS=2
COMPILER_CPUS=2
COMPILER_MEM=3g

LOG_LEVEL=info

# ИИ-разбор неудачных сдач (Yandex AI Studio, OpenAI-совместимый API). Пусто — функция выключена.
# Ключ API сервисного аккаунта с ролью ai.languageModels.user и идентификатор каталога Yandex Cloud.
AI_API_KEY=
AI_FOLDER=
# Модель (по умолчанию qwen3.6-35b-a3b/latest) и адрес API — менять обычно не нужно
AI_MODEL=
AI_BASE_URL=
